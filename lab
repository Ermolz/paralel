#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
selected_lab=lab01
if [[ "${1:-}" =~ ^lab[0-9]{2,}$ ]]; then
    selected_lab="$1"
    shift
fi
if [[ ! -f "$project_dir/$selected_lab/lab" ]]; then
    echo "$selected_lab has no runnable assignment yet." >&2
    exit 2
fi
exec bash "$project_dir/$selected_lab/lab" "$@"
