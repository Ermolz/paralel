#!/usr/bin/env bash
set -euo pipefail
lab_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_dir="$(cd -- "$lab_dir/.." && pwd)"
source "$project_dir/scripts/env.sh"
action="${1:-all}"

if (( $# > 1 )); then
    echo 'Usage: ./lab lab06 [all|reduce|allreduce|reducescatter|scan|barrier|build]' >&2
    exit 2
fi
case "$action" in
    all|reduce|allreduce|reducescatter|scan|barrier|build) ;;
    *) echo 'Usage: ./lab lab06 [all|reduce|allreduce|reducescatter|scan|barrier|build]' >&2; exit 2 ;;
esac

mvn -q -o -f "$project_dir/pom.xml" -Dlab.directory=lab06 compile
if [[ "$action" == build ]]; then
    exit 0
fi

run_program() {
    printf '\n%s (4 processes)\n' "$1"
    mpirun --oversubscribe --bind-to none --timeout 60 -np 4 \
        java -cp "$lab_dir/target/classes:$project_dir/lib/mpi.jar" \
        "com.mathpar.NAUKMA.stud2026.GR03.yermolovych.$1"
}

case "$action" in
    reduce) run_program TestReduce ;;
    allreduce) run_program TestAllReduce ;;
    reducescatter) run_program TestReduceScatter ;;
    scan) run_program TestScan ;;
    barrier) run_program TestBarrier ;;
    all)
        run_program TestReduce
        run_program TestAllReduce
        run_program TestReduceScatter
        run_program TestScan
        run_program TestBarrier
        ;;
esac
