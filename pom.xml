<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.mathpar.NAUKMA</groupId>
    <artifactId>parallel-lab1</artifactId>
    <version>1.0.0</version>
    <name>Parallel programming labs</name>

    <properties>
        <lab.directory>lab01</lab.directory>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>local-openmpi</id>
            <url>file://${project.basedir}/lib/maven</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.open-mpi</groupId>
            <artifactId>mpi</artifactId>
            <version>4.1.6</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>mathpar</id>
            <properties>
                <maven.compiler.proc>none</maven.compiler.proc>
            </properties>
            <activation>
                <property>
                    <name>lab.directory</name>
                    <value>lab08</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.mathpar</groupId>
                    <artifactId>mathpar-core</artifactId>
                    <version>9.0-local</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <sourceDirectory>${project.basedir}/${lab.directory}/src/main/java</sourceDirectory>
        <directory>${project.basedir}/${lab.directory}/target</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
        </plugins>
    </build>
</project>
